# HeatSense Environment Configuration Template
# Copy to .env and adjust values for local development.

# Application Environment (development, testing, staging, production)
HEATSENSE_ENV=development

# Server Configuration
HEATSENSE_HOST=127.0.0.1
HEATSENSE_PORT=8000
HEATSENSE_LOG_LEVEL=INFO
HEATSENSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Data & Artifact Directories (relative to project root or absolute)
HEATSENSE_DATA_DIR=data
HEATSENSE_ARTIFACTS_DIR=artifacts

# ML & Forecast Settings
HEATSENSE_MODEL_VERSION=v1
HEATSENSE_DEFAULT_HORIZONS=[24,48]

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional Cesium Ion Token (leave blank to use open raster basemap without Ion credentials)
VITE_CESIUM_ION_TOKEN=
